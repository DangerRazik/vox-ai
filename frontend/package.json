{
  "name": "vox-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/start-local.mjs",
    "start:frontend": "ng serve",
    "test:launcher": "node --test scripts/start-local.test.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "test:e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@playwright/test": "1.63.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "typescript": "6.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
